{
  "name": "gameclaw",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Agent-and-human web games. Play in the browser; agents use Web MCP.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm -r --filter \"@gameclaw/*\" check",
    "typecheck": "pnpm -r --filter \"@gameclaw/*\" typecheck",
    "test": "pnpm -r --filter \"@gameclaw/*\" test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:game": "node scripts/test-game.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
